    {
      "rank": 4,
      "row_id": 389674,
      "chunk_id": "32e82d2a07c8_1",
      "doc_id": "32e82d2a07c8",
      "text": "Big mistake- turns out \"renewed\" phones have original electronics/batteries and ports. The battery charger was beat up and I had to wiggle the plug and set it just right to get it to charge... but the battery also died super fast. Returned that phone- and decided to purchase a brand new Samsung Galaxy S9+ from *this* seller. Loved the phone. Smooth. Shiny. NOT glitchy. But it had a flaw- the battery died pretty fast. I reached out to the seller and from the first moment we interacted, he was incredibly helpful. I followed his requests for various troubleshooting steps to identify if it was an app issue or a battery issue- but after a few days of testing this and that, we determined that it was, in fact, the battery.",
      "score": 0.03524828267676226,
      "brand": "Samsung",
      "model": "Galaxy S9 Plus",
      "rating": 5,
      "timestamp": "2022-01-20",
      "aspect_tags": [
        "battery",
        "performance"
      ],
      "helpful_votes": 0,
      "verified": true,
