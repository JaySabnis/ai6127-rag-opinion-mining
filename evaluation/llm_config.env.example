# LLM judge for eval_rag.py (RAGAS).
# Copy this file to llm_config.env (git-ignored) and fill in the values.
# Any OpenAI-compatible endpoint works.

# Base URL of the API, e.g. https://api.openai.com/v1
LLM_BASE_URL=

# API key (never commit it)
LLM_API_KEY=

# Judge model name, e.g. gpt-4o-mini
LLM_MODEL=

# Embedding model, needed only for answer_relevancy (leave empty to skip it).
# On the same endpoint, e.g. text-embedding-3-small; or a local
# sentence-transformers model with EMBEDDING_PROVIDER=huggingface,
# e.g. BAAI/bge-small-en-v1.5 (the retriever's model; downloads once to HF_HOME).
EMBEDDING_MODEL=

# openai (default, uses LLM_BASE_URL) or huggingface (runs locally, no API cost)
EMBEDDING_PROVIDER=
